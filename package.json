{
  "name": "oc-model-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "cli": "bun ./src/cli.ts",
    "tui": "bun ./src/tui.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "es-toolkit": "^1.53.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@biomejs/biome": "^2.6.5",
    "typescript": "^7.0.2"
  }
}
